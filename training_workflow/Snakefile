import os
import hashlib

BG_BASE_DIR = "/eos/user/m/mroine/NanoTuples/Htautau/data_workflow/background"
VALID_BGS = ["TTto4Q", "TTtoLNu2Q", "TTto2L2Nu", "DYto2Tau"]

VAR_SETS = {
    "greedy": {
        "Tau": ["tau_rawPNetVSjet", "tau_rawUParTVSjet", "tau_qConfPNet", "tau_pt", "tau_probDM11PNet"],
        "AK8": ["fj_globalParT3_Xtauhtauh", "fj_globalParT3_TopbWqq", "fj_globalParT3_QCD", "fj_pt", "fj_tau4", "fj_globalParT3_XWW3q"],
        "AK15": ["ak15_ParTv3_probXtauhtauh", "ak15_ParTv3_probQCD", "ak15_ParTv3_probXWW3q", "ak15_tau3", "ak15_ParTv3_probTopbWqq", "ak15_ParTv3_probTopbWq", "ak15_ParTv3_probXWW4q", "ak15_pt"]
    }
}

# -----------------------
# CONFIG
# ----------------------
config.setdefault("sigs", ["Tau", "fatJet", "AK15"]) 
config.setdefault("channel", "mix")
config.setdefault("sig_generator", "MADGRAPH")
config.setdefault("bg", "TTto4Q")
config.setdefault("num_taus", 2)
config.setdefault("use_subjets", False)
config.setdefault("cms_label", "Work in Progress")
config.setdefault("compare_names", None)
config.setdefault("use_all", True)
config.setdefault("use_weights", False)
config.setdefault("variables", "")
config.setdefault("fpr", [1.0])

raw_sigs = config["sigs"]
if isinstance(raw_sigs, str):
    SIG_BASES = [s.strip() for s in raw_sigs.split(",")]
elif not isinstance(raw_sigs, list):
    SIG_BASES = [raw_sigs]
else:
    SIG_BASES = raw_sigs

raw_fprs = config["fpr"]
if isinstance(raw_fprs, str):
    raw_fprs = [float(x.strip()) for x in raw_fprs.split(",")]
elif not isinstance(raw_fprs, list):
    raw_fprs = [raw_fprs]

FPRS = [float(f) for f in raw_fprs]
FPR_STRS = [f"{f:.6f}" for f in FPRS]

CHANNEL = config["channel"]
SIG_GENERATOR = config["sig_generator"]
USE_SUBJETS = config["use_subjets"]
NUM_TAUS = config["num_taus"]
USE_WEIGHTS = config["use_weights"]
VAR_DIR_PREFIX = f"{config['variables']}/" if config["variables"] != "" else ""
VAR_SUFFIX = f"_{config['variables']}Vars" if config["variables"] != "" else ""

SUBJET_FLAG = "--use_subjets" if USE_SUBJETS else ""
WEIGHT_FLAG = "--use_weights" if USE_WEIGHTS else ""
WEIGHT_SUFFIX = "weighted" if USE_WEIGHTS else "unweighted"
USE_ALL_FLAG = "--use_all" if config["use_all"] else ""
sub_str = "wSubjets" if USE_SUBJETS else "noSubjets"

RAW_BG_INPUT = config["bg"]
BG_LIST = [b.strip() for b in RAW_BG_INPUT.split(",")]
for bg in BG_LIST:
    if bg not in VALID_BGS:
        raise ValueError(f"Background {bg} not found: {VALID_BGS}")
BG_DIR_NAME = "_".join(BG_LIST)
BG_NAME = config["bg"]

# -----------------------------
# GENERATE PATHS
# ------------------------------

SIG_BASE_DIR = f"/eos/user/m/mroine/NanoTuples/Htautau/data_workflow/jets/{SIG_GENERATOR}"

OUT_DIR = f"results/{VAR_DIR_PREFIX}{CHANNEL}/{SIG_GENERATOR}/{BG_DIR_NAME}/{sub_str}"

def mode_from_base(base):
    if base == "Tau": return "Tau"
    if base == "fatJet": return "AK8"
    if base == "AK15": return "AK15"
    raise ValueError(f"Unknown signal base {base}")

def base_from_mode(mode):
    if mode == "Tau": return "Tau"
    if mode == "AK8": return "fatJet"
    if mode == "AK15": return "AK15"

COMPARE_MODES = [mode_from_base(b) for b in SIG_BASES]
COMPARE_NAMES = config["compare_names"] or COMPARE_MODES
MODE_TO_BG_PREFIX = {"Tau": "TauBG", "AK8": "fatJetBG", "AK15": "AK15BG"}

raw_sig_filename = "RawEventInfo_hadhad.root" if CHANNEL == "hadhad" else "RawEventInfo.root"
RAW_SIG_PATH = f"{SIG_BASE_DIR}/{raw_sig_filename}"
RAW_BG_FILES = [f"{BG_BASE_DIR}/{bg}/RawEventInfoBG_{bg}.root" for bg in BG_LIST]
RAW_BG_ARG_STR = ",".join(RAW_BG_FILES)

def sig_path_for_mode(mode):
    base = base_from_mode(mode)
    suffix = "_hadhad.root" if CHANNEL == "hadhad" else ".root"
    return f"{SIG_BASE_DIR}/{base}{suffix}"

def get_bg_files_for_mode(mode):
    return [f"{BG_BASE_DIR}/{bg}/{MODE_TO_BG_PREFIX[mode]}_{bg}.root" for bg in BG_LIST]

def bg_arg_for_mode(mode):
    return ",".join(get_bg_files_for_mode(mode))

def get_vars_for_mode(mode, var_set_name):
    if var_set_name == "all" or var_set_name not in VAR_SETS: return []
    return VAR_SETS[var_set_name].get(mode, [])

def mode_str(mode):
    return f"tau_{NUM_TAUS}taus" if mode == "Tau" else mode

def run_id_for_mode(mode):
    return f"{base_from_mode(mode)}_{mode_str(mode)}_{WEIGHT_SUFFIX}{VAR_SUFFIX}"

def get_model_file(mode):
    return f"{OUT_DIR}/bdt_{run_id_for_mode(mode)}.json"

def get_parquet_file(mode):
    return f"{OUT_DIR}/inference_results_{run_id_for_mode(mode)}.parquet"


COMPARE_ID = (
    f"cmp_{'_'.join(COMPARE_MODES)}"
    f"_{'all' if config['use_all'] else ''}"
    f"_{WEIGHT_SUFFIX}{VAR_SUFFIX}"
)
if NUM_TAUS > 1:
    COMPARE_ID = COMPARE_ID.replace("Tau", "TauPair")

# -----------------
# RULES
# -----------

rule all:
    input:
        [f"{OUT_DIR}/roc_{run_id_for_mode(m)}.png" for m in COMPARE_MODES],
        [f"{OUT_DIR}/feat_{run_id_for_mode(m)}.png" for m in COMPARE_MODES],
        [f"{OUT_DIR}/conf_{run_id_for_mode(m)}.png" for m in COMPARE_MODES],
        [f"{OUT_DIR}/auc_pt_single_{run_id_for_mode(m)}.png" for m in COMPARE_MODES],
        [get_parquet_file(m) for m in COMPARE_MODES],
        
        expand(f"{OUT_DIR}/auc_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS),
        expand(f"{OUT_DIR}/sigeff_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS),
        expand(f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_matched.png", fpr_str=FPR_STRS),
        expand(f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_absolute.png", fpr_str=FPR_STRS),
        
        f"{OUT_DIR}/abs_eval_roc_{COMPARE_ID}.png",
        f"{OUT_DIR}/abs_eval_rej_{COMPARE_ID}.png",
        
        expand(f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS),

def get_mode_from_rid(r_id):
    for m in COMPARE_MODES:
        if run_id_for_mode(m) == r_id: return m
    raise ValueError(f"Unknown r_id {r_id}")

rule plot_correlations:
    input:
        sig = lambda w: sig_path_for_mode(mode_from_base(w.base_sig)),
        bg = lambda w: get_bg_files_for_mode(mode_from_base(w.base_sig))
    output:
        sig_corr = f"{OUT_DIR}/corr_sig_{{base_sig,[^_]+}}_{{short_mode}}{VAR_SUFFIX}.png",
        bg_corr = f"{OUT_DIR}/corr_bg_{BG_DIR_NAME}_{{base_sig,[^_]+}}_{{short_mode}}{VAR_SUFFIX}.png"
    params:
        bg_arg = lambda w: bg_arg_for_mode(mode_from_base(w.base_sig)),
        mode = lambda w: mode_from_base(w.base_sig),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        cms_label = config["cms_label"],
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(mode_from_base(w.base_sig), config['variables']))}" if get_vars_for_mode(mode_from_base(w.base_sig), config['variables']) else ""
    shell:
        """
        python correlations.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --out_sig {output.sig_corr} \
            --out_bg {output.bg_corr} \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            --cms-label "{params.cms_label}" \
            {params.var_flag}
        """

rule train_bdt:
    input:
        sig = lambda w: sig_path_for_mode(get_mode_from_rid(w.r_id)),
        bg = lambda w: get_bg_files_for_mode(get_mode_from_rid(w.r_id))
    output:
        model = f"{OUT_DIR}/bdt_{{r_id}}.json"
    params:
        bg_arg = lambda w: bg_arg_for_mode(get_mode_from_rid(w.r_id)),
        mode = lambda w: get_mode_from_rid(w.r_id),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']))}" if get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']) else ""
    threads: 4
    shell:
        """
        python train_BDT.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --out_model {output.model} \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            --n_workers {threads} \
            {params.var_flag}
        """

rule bdt_inference:
    input:
        roc = expand(f"{OUT_DIR}/roc_{{r_id}}.png", r_id=[run_id_for_mode(m) for m in COMPARE_MODES]),
        feat = expand(f"{OUT_DIR}/feat_{{r_id}}.png", r_id=[run_id_for_mode(m) for m in COMPARE_MODES]),
        conf = expand(f"{OUT_DIR}/conf_{{r_id}}.png", r_id=[run_id_for_mode(m) for m in COMPARE_MODES]),
        auc_pt = expand(f"{OUT_DIR}/auc_pt_single_{{r_id}}.png", r_id=[run_id_for_mode(m) for m in COMPARE_MODES]),
        parquet = expand(f"{OUT_DIR}/inference_results_{{r_id}}.parquet", r_id=[run_id_for_mode(m) for m in COMPARE_MODES])

rule run_bdt_inference:
    input:
        sig = lambda w: sig_path_for_mode(get_mode_from_rid(w.r_id)),
        bg = lambda w: get_bg_files_for_mode(get_mode_from_rid(w.r_id)),
        model = f"{OUT_DIR}/bdt_{{r_id}}.json",
    output:
        roc = f"{OUT_DIR}/roc_{{r_id}}.png",
        feat = f"{OUT_DIR}/feat_{{r_id}}.png",
        conf = f"{OUT_DIR}/conf_{{r_id}}.png",
        auc_pt = f"{OUT_DIR}/auc_pt_single_{{r_id}}.png",
        parquet = f"{OUT_DIR}/inference_results_{{r_id}}.parquet"
    params:
        bg_arg = lambda w: bg_arg_for_mode(get_mode_from_rid(w.r_id)),
        mode = lambda w: get_mode_from_rid(w.r_id),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        cms_label = config["cms_label"],
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']))}" if get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']) else ""
    threads: 4
    shell:
        """
        python BDT_inference.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --model {input.model} \
            --out_parquet {output.parquet} \
            --out_roc {output.roc} \
            --out_feat {output.feat} \
            --out_conf {output.conf} \
            --out_auc_pt {output.auc_pt} \
            --cms_label "{params.cms_label}" \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            {params.var_flag} \
            --n_workers {threads} \
            {WEIGHT_FLAG}
        """

rule compare_bdts:
    input:
        expand(f"{OUT_DIR}/sigeff_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS),
        expand(f"{OUT_DIR}/auc_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS)

rule run_compare_bdts:
    input:
        parquets = [get_parquet_file(m) for m in COMPARE_MODES]
    output:
        plot_auc = f"{OUT_DIR}/auc_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png",
        plot_sig_eff = f"{OUT_DIR}/sigeff_pt_compare_{COMPARE_ID}_FPR{{fpr_str}}.png"
    params:
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        bg_name = BG_DIR_NAME,
        fpr = lambda wildcards: float(wildcards.fpr_str) / 100.0,
        weight_flag = WEIGHT_FLAG,
        cms_label = config["cms_label"]
    shell:
        """
        python BDT_inference_fair.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --out_plot {output.plot_auc} \
            --out_eff_plot {output.plot_sig_eff} \
            --cms_label "{params.cms_label}" \
            --bg_mode {params.bg_name} \
            --num_taus {params.num_taus} \
            --fpr {params.fpr} \
            {params.subjet_flag} \
            {params.use_all_flag} \
            {params.weight_flag}
        """

rule compare_tagging_effs:
    input:
        expand(f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_matched.png", fpr_str=FPR_STRS),
        expand(f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_absolute.png", fpr_str=FPR_STRS)

rule run_compare_tagging_eff:
    input:
        parquets = [get_parquet_file(m) for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH
    output:
        matched = f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_matched.png",
        absolute = f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}_absolute.png"
    params:
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        base_plot_name = f"{OUT_DIR}/tagging_eff_compare_{COMPARE_ID}_FPR{{fpr_str}}.png",
        fpr = lambda wildcards: float(wildcards.fpr_str) / 100.0,
        bg_name = BG_DIR_NAME,
        weight_flag = WEIGHT_FLAG,
        cms_label = config["cms_label"],
        
    shell:
        """
        python tagging_efficiency.py \
            --parquets {input.parquets} \
            --bg_mode {params.bg_name} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --cms_label "{params.cms_label}" \
            --out_plot {params.base_plot_name} \
            --num_taus {params.num_taus} \
            --fpr {params.fpr} \
            --use_all {USE_ALL_FLAG} \
            {params.subjet_flag} \
            {params.weight_flag}
        """

rule absolute_evaluation:
    input:
        f"{OUT_DIR}/abs_eval_roc_{COMPARE_ID}.png",
        f"{OUT_DIR}/abs_eval_rej_{COMPARE_ID}.png",
        expand(f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS),
        f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_animation.gif"

rule absolute_roc:
    input:
        f"{OUT_DIR}/abs_eval_roc_{COMPARE_ID}.png"

rule absolute_eff:
    input:
        expand(f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_FPR{{fpr_str}}.png", fpr_str=FPR_STRS)

rule run_absolute_evaluation_roc:
    input:
        parquets = [get_parquet_file(m) for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH,
        raw_bgs = RAW_BG_FILES
    output:
        plot_roc = f"{OUT_DIR}/abs_eval_roc_{COMPARE_ID}.png",
        plot_rej = f"{OUT_DIR}/abs_eval_rej_{COMPARE_ID}.png"
    params:
        modes = COMPARE_MODES,
        raw_bg_arg = RAW_BG_ARG_STR,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        bg_name = BG_DIR_NAME,
        weight_flag = WEIGHT_FLAG,
        cms_label = config["cms_label"]
    shell:
        """
        python theUltimateComparison.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --raw_bg {params.raw_bg_arg} \
            --cms_label "{params.cms_label}" \
            --bg_mode {params.bg_name} \
            --out_plot {output.plot_roc} \
            --out_rej_plot {output.plot_rej} \
            --num_taus {params.num_taus} \
            {params.subjet_flag} \
            {params.use_all_flag} \
            {params.weight_flag}
        """

rule run_absolute_evaluation_eff:
    input:
        parquets = [get_parquet_file(m) for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH,
        raw_bgs = RAW_BG_FILES
    output:
        plot_eff = f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_FPR{{fpr_str}}.png"
    params:
        raw_bg_arg = RAW_BG_ARG_STR,
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        bg_name = BG_DIR_NAME,
        cms_label = config["cms_label"],
        fpr = lambda wildcards: float(wildcards.fpr_str) / 100.0
    shell:
        """
        python AbsoluteEfficiency.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --raw_bg {params.raw_bg_arg} \
            --bg_mode {params.bg_name} \
            --out_plot {output.plot_eff} \
            --cms_label "{params.cms_label}" \
            --num_taus {params.num_taus} \
            --fpr {params.fpr} \
            {params.subjet_flag} \
            {params.use_all_flag} \
            {WEIGHT_FLAG}
        """

rule run_absolute_evaluation_animation:
    input:
        parquets = [get_parquet_file(m) for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH,
        raw_bgs = RAW_BG_FILES
    output:
        plot_anim = f"{OUT_DIR}/abs_eval_sigeff_pt_{COMPARE_ID}_animation.gif"
    params:
        raw_bg_args = RAW_BG_ARG_STR,
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        frames = 50,
        bg_name = BG_DIR_NAME,
        cms_label = config["cms_label"]
    shell:
        """
        python createAbsoluteEffAnimation.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --raw_bg {params.raw_bg_args} \
            --cms_label "{params.cms_label}" \
            --bg_mode {params.bg_name} \
            --out_plot {output.plot_anim} \
            --num_taus {params.num_taus} \
            --frames {params.frames} \
            {params.subjet_flag} \
            {params.use_all_flag}
        """

rule visualize_models:
    input:
        expand(f"{OUT_DIR}/random_trees_{COMPARE_ID}/{{mode}}", mode=COMPARE_MODES)

rule run_visualize_models:
    input:
        model = lambda wildcards: get_model_file(wildcards.mode)
    output:
        out_dir = directory(f"{OUT_DIR}/random_trees_{COMPARE_ID}/{{mode}}")
    params:
        name = lambda wildcards: COMPARE_NAMES[COMPARE_MODES.index(wildcards.mode)]
    shell:
        """
        python VisualizeTree.py \
            --model_path {input.model} \
            --model_name {params.name} \
            --out_dir {output.out_dir}
        """