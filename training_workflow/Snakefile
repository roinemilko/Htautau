import os
import hashlib

from snakemake.exceptions import WorkflowError

REPO_ROOT = os.path.dirname(os.path.realpath(workflow.basedir))
DATA_WORKFLOW_DIR = os.path.join(REPO_ROOT, "data_workflow")

BG_BASE_DIR = f"{DATA_WORKFLOW_DIR}/background"

_valid_bgs_raw = config.get("bg-channels")
if not _valid_bgs_raw:
    raise WorkflowError(
        "config.yaml is missing 'bg-channels' (shared with data_workflow/plot_workflow); "
        "training_workflow needs it to validate the 'bg'/'bg_sets' selection."
    )
VALID_BGS = (
    [b.strip() for b in _valid_bgs_raw.split(",")]
    if isinstance(_valid_bgs_raw, str) else list(_valid_bgs_raw)
)

VAR_SETS = {
    "greedy": {
        "Tau": ["tau_rawPNetVSjet", "tau_rawUParTVSjet", "tau_qConfPNet", "tau_pt", "tau_probDM11PNet"],
        "AK8": ["fj_globalParT3_Xtauhtauh", "fj_globalParT3_TopbWqq", "fj_globalParT3_QCD", "fj_pt", "fj_tau4", "fj_globalParT3_XWW3q"],
        "AK15": ["ak15_ParTv3_probXtauhtauh", "ak15_ParTv3_probQCD", "ak15_ParTv3_probXWW3q", "ak15_tau3", "ak15_ParTv3_probTopbWqq", "ak15_ParTv3_probTopbWq", "ak15_ParTv3_probXWW4q", "ak15_pt"]
    }
}

# -----------------------
# CONFIG
# ----------------------
# Defaults are applied in place on `config` (rather than via config.setdefault, which only
# fills in *absent* keys) so a key that is *present but blank/null* in config.yaml (e.g. an
# empty "variables:" field) also falls back to its default, instead of silently becoming
# None/"None" downstream (see VAR_DIR_PREFIX below).
_CONFIG_DEFAULTS = {
    "sigs": ["Tau", "fatJet", "AK15"],
    "training_channel": "mix",
    "sig_generator": "MADGRAPH",
    "bg": "TTto4Q",
    "num_taus": 2,
    "use_subjets": False,
    "cms_label": "Work in Progress",
    "compare_names": None,
    "use_all": True,
    "variables": "",
    "fpr": [1.0],
}
for _key, _default in _CONFIG_DEFAULTS.items():
    if config.get(_key) is None:
        config[_key] = _default

raw_sigs = config["sigs"]
if isinstance(raw_sigs, str):
    SIG_BASES = [s.strip() for s in raw_sigs.split(",")]
elif not isinstance(raw_sigs, list):
    SIG_BASES = [raw_sigs]
else:
    SIG_BASES = raw_sigs

raw_fprs = config["fpr"]
if isinstance(raw_fprs, str):
    raw_fprs = [float(x.strip()) for x in raw_fprs.split(",")]
elif not isinstance(raw_fprs, list):
    raw_fprs = [raw_fprs]

FPRS = [float(f) for f in raw_fprs]
FPR_STRS = [f"{f:.6f}" for f in FPRS]

CHANNEL = config["training_channel"]
SIG_GENERATOR = config["sig_generator"]
USE_SUBJETS = config["use_subjets"]
NUM_TAUS = config["num_taus"]
VAR_DIR_PREFIX = f"{config['variables']}/" if config["variables"] != "" else ""
VAR_SUFFIX = f"_{config['variables']}Vars" if config["variables"] != "" else ""

SUBJET_FLAG = "--use_subjets" if USE_SUBJETS else ""
USE_ALL_FLAG = "--use_all" if config["use_all"] else ""
sub_str = "wSubjets" if USE_SUBJETS else "noSubjets"

raw_bg_input = config.get("bg_sets", config.get("bg", ["TTto4Q"]))
if isinstance(raw_bg_input, str):
    raw_bg_input = [raw_bg_input]

BG_SETS = []
for bg_set_str in raw_bg_input:
    bgs = [b.strip() for b in bg_set_str.split(",")]
    for bg in bgs:
        if bg not in VALID_BGS:
            raise WorkflowError(f"Background '{bg}' not found. Valid options: {VALID_BGS}")
    BG_SETS.append("_".join(bgs))

def get_bg_list(bg_dir):
    return bg_dir.split("_")

def use_weights(bg_dir):
    return len(get_bg_list(bg_dir)) > 1

def get_weight_suffix(bg_dir):
    return "weighted" if use_weights(bg_dir) else "unweighted"

def get_weight_flag(bg_dir):
    return "--use_weights" if use_weights(bg_dir) else ""

# -----------------------------
# MAKE PATHS
# ------------------------------

SIG_BASE_DIR = f"{DATA_WORKFLOW_DIR}/jets/{SIG_GENERATOR}"
OUT_DIR_BASE = f"results/{VAR_DIR_PREFIX}{CHANNEL}/{SIG_GENERATOR}"

def _validate_training_inputs():
    problems = []
    known_generators = {**(config.get("signal_dirs") or {}), **(config.get("signal_das") or {})}
    if SIG_GENERATOR not in known_generators:
        problems.append(
            f"sig_generator '{SIG_GENERATOR}' has no entry in signal_dirs/signal_das in config.yaml"
        )
    elif not os.path.isdir(SIG_BASE_DIR):
        problems.append(
            f"expected skimmed signal jets under {SIG_BASE_DIR} (run data_workflow's 'skim' rule first)"
        )
    all_bgs = {bg for bg_dir in BG_SETS for bg in get_bg_list(bg_dir)}
    for bg in sorted(all_bgs):
        bg_path = f"{BG_BASE_DIR}/{bg}"
        if not os.path.isdir(bg_path):
            problems.append(
                f"background '{bg}': no skims found under {bg_path} "
                "(run data_workflow's 'skim_bg' rule first)"
            )
    if problems:
        raise WorkflowError(
            "training_workflow can't find required inputs:\n  - " + "\n  - ".join(problems)
        )

_validate_training_inputs()

def mode_from_base(base):
    if base == "Tau": return "Tau"
    if base == "fatJet": return "AK8"
    if base == "AK15": return "AK15"
    raise WorkflowError(
        f"Unknown entry '{base}' in config 'sigs': expected one of Tau, fatJet, AK15"
    )

def base_from_mode(mode):
    if mode == "Tau": return "Tau"
    if mode == "AK8": return "fatJet"
    if mode == "AK15": return "AK15"

COMPARE_MODES = [mode_from_base(b) for b in SIG_BASES]
COMPARE_NAMES = config["compare_names"] or COMPARE_MODES
MODE_TO_BG_PREFIX = {"Tau": "TauBG", "AK8": "fatJetBG", "AK15": "AK15BG"}

raw_sig_filename = "RawEventInfo_hadhad.root" if CHANNEL == "hadhad" else "RawEventInfo.root"
RAW_SIG_PATH = f"{SIG_BASE_DIR}/{raw_sig_filename}"

def raw_bg_files(bg_dir):
    return [f"{BG_BASE_DIR}/{bg}/RawEventInfoBG_{bg}.root" for bg in get_bg_list(bg_dir)]

def raw_bg_arg(bg_dir):
    return ",".join(raw_bg_files(bg_dir))

def sig_path_for_mode(mode):
    base = base_from_mode(mode)
    suffix = "_hadhad.root" if CHANNEL == "hadhad" else ".root"
    return f"{SIG_BASE_DIR}/{base}{suffix}"

def get_bg_files_for_mode(mode, bg_dir):
    return [f"{BG_BASE_DIR}/{bg}/{MODE_TO_BG_PREFIX[mode]}_{bg}.root" for bg in get_bg_list(bg_dir)]

def bg_arg_for_mode(mode, bg_dir):
    return ",".join(get_bg_files_for_mode(mode, bg_dir))

def get_vars_for_mode(mode, var_set_name):
    if var_set_name == "all" or var_set_name not in VAR_SETS: return []
    return VAR_SETS[var_set_name].get(mode, [])

def mode_str(mode):
    return f"tau_{NUM_TAUS}taus" if mode == "Tau" else mode

def run_id_for_mode(mode, bg_dir):
    return f"{base_from_mode(mode)}_{mode_str(mode)}_{get_weight_suffix(bg_dir)}{VAR_SUFFIX}"

def get_mode_from_rid(r_id):
    for m in COMPARE_MODES:
        if r_id.startswith(f"{base_from_mode(m)}_{mode_str(m)}"): return m
    raise ValueError(f"Unknown r_id {r_id}")

def get_compare_id(bg_dir):
    cmp = f"cmp_{'_'.join(COMPARE_MODES)}_{'all' if config['use_all'] else ''}_{get_weight_suffix(bg_dir)}{VAR_SUFFIX}"
    return cmp.replace("Tau", "TauPair") if NUM_TAUS > 1 else cmp

EXPECTED_OUTPUTS = []
for bg_dir in BG_SETS:
    out_dir = f"{OUT_DIR_BASE}/{bg_dir}/{sub_str}"
    cmp_id = get_compare_id(bg_dir)
    
    for m in COMPARE_MODES:
        r_id = run_id_for_mode(m, bg_dir)
        EXPECTED_OUTPUTS.extend([
            f"{out_dir}/roc_{r_id}.png",
            f"{out_dir}/feat_{r_id}.png",
            f"{out_dir}/conf_{r_id}.png",
            f"{out_dir}/auc_pt_single_{r_id}.png",
            f"{out_dir}/inference_results_{r_id}.parquet"
        ])
        
    for fpr_str in FPR_STRS:
        EXPECTED_OUTPUTS.extend([
            f"{out_dir}/auc_pt_compare_{cmp_id}_FPR{fpr_str}.png",
            f"{out_dir}/sigeff_pt_compare_{cmp_id}_FPR{fpr_str}.png",
            f"{out_dir}/tagging_eff_compare_{cmp_id}_FPR{fpr_str}_matched.png",
            f"{out_dir}/tagging_eff_compare_{cmp_id}_FPR{fpr_str}_absolute.png",
            f"{out_dir}/abs_eval_sigeff_pt_{cmp_id}_FPR{fpr_str}.png",
        ])
        
    EXPECTED_OUTPUTS.extend([
        f"{out_dir}/abs_eval_roc_{cmp_id}.png",
        f"{out_dir}/abs_eval_rej_{cmp_id}.png",
    ])

# -----------------
# RULES
# -----------

rule all:
    input:
        EXPECTED_OUTPUTS

rule plot_correlations:
    input:
        sig = lambda w: sig_path_for_mode(mode_from_base(w.base_sig)),
        bg = lambda w: get_bg_files_for_mode(mode_from_base(w.base_sig), w.bg_dir)
    output:
        sig_corr = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/corr_sig_{{base_sig,[^_]+}}_{{short_mode}}{VAR_SUFFIX}.png",
        bg_corr = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/corr_bg_{{bg_dir}}_{{base_sig,[^_]+}}_{{short_mode}}{VAR_SUFFIX}.png"
    params:
        bg_arg = lambda w: bg_arg_for_mode(mode_from_base(w.base_sig), w.bg_dir),
        mode = lambda w: mode_from_base(w.base_sig),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        cms_label = config["cms_label"],
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(mode_from_base(w.base_sig), config['variables']))}" if get_vars_for_mode(mode_from_base(w.base_sig), config['variables']) else ""
    # Loads full sig/bg trees into memory; throttled like the other plotting rules
    # below (see run.sh for the pool size) so --cores doesn't run dozens at once.
    resources:
        plot_slot = 1
    shell:
        """
        python correlations.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --out_sig {output.sig_corr} \
            --out_bg {output.bg_corr} \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            --cms-label "{params.cms_label}" \
            {params.var_flag}
        """

rule train_bdt:
    input:
        sig = lambda w: sig_path_for_mode(get_mode_from_rid(w.r_id)),
        bg = lambda w: get_bg_files_for_mode(get_mode_from_rid(w.r_id), w.bg_dir)
    output:
        model = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/bdt_{{r_id}}.json"
    params:
        bg_arg = lambda w: bg_arg_for_mode(get_mode_from_rid(w.r_id), w.bg_dir),
        mode = lambda w: get_mode_from_rid(w.r_id),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']))}" if get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']) else ""
    threads: 4
    # Each job spins up its own dask LocalCluster (n_workers=threads, memory_limit=5GB
    # per worker, i.e. ~20GB for this rule's default threads:4). Running many of these
    # at once under a high --cores count OOMs the machine, so throttle concurrency
    # with a shared resource independent of --cores (see run.sh for the pool size).
    resources:
        bdt_slot = 1
    shell:
        """
        python train_BDT.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --out_model {output.model} \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            --n_workers {threads} \
            {params.var_flag}
        """

rule run_bdt_inference:
    input:
        sig = lambda w: sig_path_for_mode(get_mode_from_rid(w.r_id)),
        bg = lambda w: get_bg_files_for_mode(get_mode_from_rid(w.r_id), w.bg_dir),
        model = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/bdt_{{r_id}}.json",
    output:
        roc = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/roc_{{r_id}}.png",
        feat = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/feat_{{r_id}}.png",
        conf = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/conf_{{r_id}}.png",
        auc_pt = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/auc_pt_single_{{r_id}}.png",
        parquet = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/inference_results_{{r_id}}.parquet"
    params:
        bg_arg = lambda w: bg_arg_for_mode(get_mode_from_rid(w.r_id), w.bg_dir),
        mode = lambda w: get_mode_from_rid(w.r_id),
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        cms_label = config["cms_label"],
        var_flag = lambda w: f"--variables {' '.join(get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']))}" if get_vars_for_mode(get_mode_from_rid(w.r_id), config['variables']) else "",
        weight_flag = lambda w: get_weight_flag(w.bg_dir)
    threads: 4
    # Same dask-memory-per-job concern as rule train_bdt: share the same throttle
    # pool so training and inference jobs don't stack on top of each other either.
    resources:
        bdt_slot = 1
    shell:
        """
        python BDT_inference.py \
            --sig {input.sig} \
            --bg {params.bg_arg} \
            --model {input.model} \
            --out_parquet {output.parquet} \
            --out_roc {output.roc} \
            --out_feat {output.feat} \
            --out_conf {output.conf} \
            --out_auc_pt {output.auc_pt} \
            --cms_label "{params.cms_label}" \
            --mode {params.mode} \
            {params.subjet_flag} \
            --num_taus {params.num_taus} \
            {params.var_flag} \
            --n_workers {threads} \
            {params.weight_flag}
        """

rule run_compare_bdts:
    input:
        parquets = lambda w: [f"{OUT_DIR_BASE}/{w.bg_dir}/{sub_str}/inference_results_{run_id_for_mode(m, w.bg_dir)}.parquet" for m in COMPARE_MODES]
    output:
        plot_auc = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/auc_pt_compare_{{cmp_id}}_FPR{{fpr_str}}.png",
        plot_sig_eff = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/sigeff_pt_compare_{{cmp_id}}_FPR{{fpr_str}}.png"
    params:
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        bg_name = lambda w: w.bg_dir,
        fpr = lambda wildcards: float(wildcards.fpr_str) / 100.0,
        weight_flag = lambda w: get_weight_flag(w.bg_dir),
        cms_label = config["cms_label"]
    # Loads all COMPARE_MODES' inference parquets into memory at once; throttle
    # concurrency so --cores doesn't run dozens of these simultaneously (see run.sh).
    resources:
        plot_slot = 1
    shell:
        """
        python BDT_inference_fair.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --out_plot {output.plot_auc} \
            --out_eff_plot {output.plot_sig_eff} \
            --cms_label "{params.cms_label}" \
            --bg_mode {params.bg_name} \
            --num_taus {params.num_taus} \
            --fpr {params.fpr} \
            {params.subjet_flag} \
            {params.use_all_flag} \
            {params.weight_flag}
        """

rule run_compare_tagging_eff:
    input:
        parquets = lambda w: [f"{OUT_DIR_BASE}/{w.bg_dir}/{sub_str}/inference_results_{run_id_for_mode(m, w.bg_dir)}.parquet" for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH
    output:
        matched = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/tagging_eff_compare_{{cmp_id}}_FPR{{fpr_str}}_matched.png",
        absolute = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/tagging_eff_compare_{{cmp_id}}_FPR{{fpr_str}}_absolute.png"
    params:
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        base_plot_name = lambda w: f"{OUT_DIR_BASE}/{w.bg_dir}/{sub_str}/tagging_eff_compare_{w.cmp_id}_FPR{w.fpr_str}.png",
        fpr = lambda wildcards: float(wildcards.fpr_str) / 100.0,
        bg_name = lambda w: w.bg_dir,
        weight_flag = lambda w: get_weight_flag(w.bg_dir),
        cms_label = config["cms_label"]
    resources:
        plot_slot = 1
    shell:
        """
        python tagging_efficiency.py \
            --parquets {input.parquets} \
            --bg_mode {params.bg_name} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --cms_label "{params.cms_label}" \
            --out_plot {params.base_plot_name} \
            --num_taus {params.num_taus} \
            --fpr {params.fpr} \
            --use_all {USE_ALL_FLAG} \
            {params.subjet_flag} \
            {params.weight_flag}
        """

