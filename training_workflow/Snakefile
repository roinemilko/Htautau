rule run_absolute_evaluation_animation:
    input:
        parquets = lambda w: [f"{OUT_DIR_BASE}/{w.bg_dir}/{sub_str}/inference_results_{run_id_for_mode(m, w.bg_dir)}.parquet" for m in COMPARE_MODES],
        raw_sig = RAW_SIG_PATH,
        raw_bgs = lambda w: raw_bg_files(w.bg_dir)
    output:
        plot_anim = f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/abs_eval_sigeff_pt_{{cmp_id}}_animation.gif"
    params:
        raw_bg_args = lambda w: raw_bg_arg(w.bg_dir),
        modes = COMPARE_MODES,
        names = COMPARE_NAMES,
        num_taus = NUM_TAUS,
        subjet_flag = SUBJET_FLAG,
        use_all_flag = USE_ALL_FLAG,
        frames = 50,
        bg_name = lambda w: w.bg_dir,
        cms_label = config["cms_label"]
    resources:
        plot_slot = 1
    shell:
        """
        python createAbsoluteEffAnimation.py \
            --parquets {input.parquets} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --raw_bg {params.raw_bg_args} \
            --cms_label "{params.cms_label}" \
            --bg_mode {params.bg_name} \
            --out_plot {output.plot_anim} \
            --num_taus {params.num_taus} \
            --frames {params.frames} \
            {params.subjet_flag} \
            {params.use_all_flag}
        """

rule run_visualize_models:
    input:
        model = lambda w: f"{OUT_DIR_BASE}/{w.bg_dir}/{sub_str}/bdt_{run_id_for_mode(w.mode, w.bg_dir)}.json"
    output:
        out_dir = directory(f"{OUT_DIR_BASE}/{{bg_dir}}/{sub_str}/random_trees_{{cmp_id}}/{{mode}}")
    params:
        name = lambda w: COMPARE_NAMES[COMPARE_MODES.index(w.mode)]
    shell:
        """
        python VisualizeTree.py \
            --model_path {input.model} \
            --model_name {params.name} \
            --out_dir {output.out_dir}
        """