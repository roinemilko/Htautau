        use_all_flag = USE_ALL_FLAG,
        frames = 50,
        bg_name = BG_NAME
    shell:
        """
        python createAbsoluteEffAnimation.py \
            --sigs {input.sigs} \
            --bgs {input.bgs} \
            --models {input.models} \
            --modes {params.modes} \
            --names {params.names} \
            --raw_sig {input.raw_sig} \
            --raw_bg {input.raw_bg} \
