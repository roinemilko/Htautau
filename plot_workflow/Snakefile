import os

from snakemake.exceptions import WorkflowError

REPO_ROOT = os.path.dirname(os.path.realpath(workflow.basedir))
DATA_WORKFLOW_DIR = os.path.join(REPO_ROOT, "data_workflow")

# Defaults are applied here (rather than via config.get(key, default)) so a key that is
# *present but blank/null* in config.yaml falls back too, instead of silently becoming
# None downstream.
_CONFIG_DEFAULTS = {
    "data": "MADGRAPH, POWHEG",
    "channel": "both",
    "exclude": "",
    "bg-channels": "DYto2Tau, TTto2L2Nu, TTto4Q, TTtoLNu2Q",
    "normalize": "true",
    "jet_params": "XX_mass, XX_pt, XX_mass/XX_pt, abs(XX_eta)",
    "subjet_params": "XX_Subjet_mass, XX_Subjet_pt, XX_Subjet_mass/XX_Subjet_pt, abs(XX_Subjet_eta)",
}
for _key, _default in _CONFIG_DEFAULTS.items():
    if config.get(_key) is None:
        config[_key] = _default

_use_data_str   = config["data"]
_channel_mode   = config["channel"]
_excluded_str   = config["exclude"]
_bg_channel_str = config["bg-channels"]
NORMALIZE       = config["normalize"]

JET_PARAMS      = config["jet_params"]
SUBJET_PARAMS   = config["subjet_params"]

DATA          = [x.strip() for x in _use_data_str.split(",")]
REQUESTED_BGS = [x.strip() for x in _bg_channel_str.split(",")] if _bg_channel_str else [""]
EXCLUDED_JETS = [x.strip() for x in _excluded_str.split(",")] if _excluded_str else []

DATA_MAP = {dataset: f"{DATA_WORKFLOW_DIR}/jets/{dataset}" for dataset in DATA}
BG_MAP   = {bg: f"{DATA_WORKFLOW_DIR}/background/{bg}" for bg in REQUESTED_BGS if bg}

_HADHAD = "_hadhad"

JET_NAMES = {
    "AK4": "Jet",
    "AK8": "fatJet",
    "AK15": "AK15",
    "Tau": "Tau"
}

BG_NAMES = {
    "AK4": "JetBG",
    "AK8": "fatJetBG",
    "AK15": "AK15BG",
    "Tau": "TauBG"
}

JET_PREFIXES = {
    "AK4": "Jet_",
    "AK8": "FatJet_",
    "AK15": "AK15_",
    "Tau": "Tau_"
}

REQUESTED_JETS = [j for j in JET_NAMES.keys() if j not in EXCLUDED_JETS]
REQUESTED_SUBJETS = [j for j in REQUESTED_JETS if j in ["AK8", "AK15"]]

_clean_jet = (
    JET_PARAMS
    .replace("XX", "")
    .replace("_", "")
    .replace(" ", "")
    .replace(",", "_")
    .replace("/", "over")
)

_clean_subjet = (
    SUBJET_PARAMS
    .replace("XX", "")
    .replace("_", "")
    .replace(" ", "")
    .replace(",", "_")
    .replace("/", "over")
)

_ak4_str  = "Jet_"    if "AK4"  in REQUESTED_JETS else ""
_ak8_str  = "FatJet_" if "AK8"  in REQUESTED_JETS else ""
_ak15_str = "AK15_"   if "AK15" in REQUESTED_JETS else ""
_tau_str  = "Tau_"    if "Tau"  in REQUESTED_JETS else ""

SUFFIXES = []
if _channel_mode in ["both", "inclusive_only"]:
    SUFFIXES.append("") 
if _channel_mode in ["both", "hadhad_only"]:
    SUFFIXES.append(_HADHAD) 

CUT_LEVELS = ["loose", "tight"]
valid_bgs = [bg for bg in REQUESTED_BGS if bg]

def _validate_plot_inputs():
    problems = []
    for d in DATA:
        jets_dir = DATA_MAP[d]
        if not os.path.isdir(jets_dir):
            problems.append(
                f"dataset '{d}': no skimmed jets found under {jets_dir} "
                "(run data_workflow's 'skim' rule first)"
            )
    for bg in valid_bgs:
        bg_dir = BG_MAP.get(bg)
        if bg_dir and not os.path.isdir(bg_dir):
            problems.append(
                f"background '{bg}': no skims found under {bg_dir} "
                "(run data_workflow's 'skim_bg' rule first)"
            )
    if problems:
        raise WorkflowError(
            "plot_workflow can't find required inputs:\n  - " + "\n  - ".join(problems)
        )

_validate_plot_inputs()

wildcard_constraints:
    dataset = "|".join(DATA) if DATA else ".*",
    suffix = "_hadhad|",
    cut_level = "loose|tight",
    bg = "|".join(valid_bgs) if valid_bgs else ".*",
    jet_prefix = "Jet_|FatJet_|AK15_|Tau_"

EXPECTED_JET_PLOTS_SIG = [
    f"plots/{dataset}/distributions/{_ak4_str}{_ak8_str}{_ak15_str}{_tau_str}{_clean_jet}{suffix}_plot.png"
    for dataset in DATA for suffix in SUFFIXES
]

EXPECTED_JET_PLOTS_BG = [
    f"plots/{dataset}/distributions/{JET_PREFIXES[j]}{_clean_jet}{suffix}_{bg}_plot.png"
    for dataset in DATA for suffix in SUFFIXES for bg in valid_bgs for j in REQUESTED_JETS
]

EXPECTED_JET_PLOTS = EXPECTED_JET_PLOTS_SIG + EXPECTED_JET_PLOTS_BG

EXPECTED_SUBJET_PLOTS_SIG = [
    f"plots/{dataset}/distributions/{_ak8_str}{_ak15_str}{_clean_subjet}{suffix}_plot.png"
    for dataset in DATA for suffix in SUFFIXES
] if REQUESTED_SUBJETS else []

EXPECTED_SUBJET_PLOTS_BG = [
    f"plots/{dataset}/distributions/{JET_PREFIXES[j]}{_clean_subjet}{suffix}_{bg}_plot.png"
    for dataset in DATA for suffix in SUFFIXES for bg in valid_bgs for j in REQUESTED_SUBJETS
] if REQUESTED_SUBJETS else []

EXPECTED_SUBJET_PLOTS = EXPECTED_SUBJET_PLOTS_SIG + EXPECTED_SUBJET_PLOTS_BG

EXPECTED_JET_EFF_PLOTS = [
    f"plots/{dataset}/efficiencies/JetFatJetAK15_eff{suffix}.png"
    for dataset in DATA
    for suffix in SUFFIXES
]

EXPECTED_SUBJET_EFF_PLOTS = [
    f"plots/{dataset}/efficiencies/SubjetMatchingEff_{cut_level}_vs_genHpt{suffix}.png"
    for dataset in DATA
    for suffix in SUFFIXES
    for cut_level in CUT_LEVELS
]

EXPECTED_EFF_DIFF_PLOTS = [
    f"plots/{dataset}/efficiencies/MatchingEffDiff_inclusive_minus_hadhad_allJets.png"
    for dataset in DATA
]

EXPECTED_CHANNEL_EFF_PLOTS = [
    f"plots/{dataset}/efficiencies/effAndResponse_byChannel_grid.png"
    for dataset in DATA
]

EXPECTED_PT_EFF_PLOTS = [
    f"plots/{dataset}/efficiencies/JetFatJetAK15_recoeff{suffix}.png"
    for dataset in DATA
    for suffix in SUFFIXES
]

EXPECTED_DECAY_PROD_PLOTS = [
    f"plots/{dataset}/efficiencies/EnergyFractionsOfDecayProds{suffix}.png"
    for dataset in DATA
    for suffix in SUFFIXES
]

EXPECTED_SANITY_PLOTS = [
    f"plots/{dataset}/sanity_checks/SanityCheck.png"
    for dataset in DATA
]

EXPECTED_KINEMATICS_PLOTS = [
    f"plots/{dataset}/sanity_checks/SanityCheckKinematics{suffix}_dR_{jet_id}_nolim{type_suffix}.png"
    for dataset in DATA
    for suffix in SUFFIXES
    for jet_id in ["Jet", "fJ", "AK15"]
    for type_suffix in ["", "_All"]
]

rule all:
    input:
        EXPECTED_JET_PLOTS,
        EXPECTED_JET_EFF_PLOTS,
        EXPECTED_SUBJET_EFF_PLOTS,
        EXPECTED_SANITY_PLOTS,
        EXPECTED_KINEMATICS_PLOTS,
        EXPECTED_EFF_DIFF_PLOTS,
        EXPECTED_DECAY_PROD_PLOTS,
        EXPECTED_CHANNEL_EFF_PLOTS,
        EXPECTED_SUBJET_PLOTS,
        EXPECTED_PT_EFF_PLOTS

rule jet_plots:
    input:
        EXPECTED_JET_PLOTS

rule subjet_plots:
    input:
        EXPECTED_SUBJET_PLOTS

rule eff_diffs:
    input:
        EXPECTED_EFF_DIFF_PLOTS

rule jet_effs:
    input:
        EXPECTED_JET_EFF_PLOTS

rule subjet_effs:
    input:
        EXPECTED_SUBJET_EFF_PLOTS

rule effs_channel:
    input:
        EXPECTED_EFF_DIFF_PLOTS,
        EXPECTED_DECAY_PROD_PLOTS,
        EXPECTED_CHANNEL_EFF_PLOTS

rule pt_effs:
    input:
        EXPECTED_PT_EFF_PLOTS

rule run_jet_effs:
    input:
        raw  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo{w.suffix}.root",
        ak8  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet{w.suffix}.root",
        ak15 = lambda w: f"{DATA_MAP[w.dataset]}/AK15{w.suffix}.root",
        tau  = lambda w: f"{DATA_MAP[w.dataset]}/Tau{w.suffix}.root"
    output:
        plot = "plots/{dataset}/efficiencies/JetFatJetAK15_eff{suffix}.png"
    params:
        is_hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        # AK4 is legacy and excluded by default; only pass its file when it was
        # actually produced upstream, so PlotEfficiencies.C can drop that series.
        ak4 = lambda w: (f"{DATA_MAP[w.dataset]}/Jet{w.suffix}.root" if "AK4" in REQUESTED_JETS else "")
    shell:
        """
        root -l -b -q 'PlotEfficiencies.C("{output.plot}", "{input.raw}", "{params.ak4}", "{input.ak8}", "{input.ak15}", "{input.tau}", {params.is_hadhad})'
        """

rule run_subjet_effs:
    input:
        raw  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo{w.suffix}.root",
        ak8  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet{w.suffix}.root",
        ak15 = lambda w: f"{DATA_MAP[w.dataset]}/AK15{w.suffix}.root"
    output:
        plot = "plots/{dataset}/efficiencies/SubjetMatchingEff_{cut_level}_vs_genHpt{suffix}.png"
    params:
        is_hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        cut_level = lambda w: "true" if w.cut_level == "loose" else "false",
        cut_ak8   = lambda w: "fj_nMatchedSubjets >= 1" if w.cut_level == "loose" else "fj_nMatchedSubjets >= 2",
        cut_ak15  = lambda w: "ak15_nMatchedSubjets >= 1" if w.cut_level == "loose" else "ak15_nMatchedSubjets >= 2"
    shell:
        """
        root -l -b -q 'PlotSubjetMatchingEffs.C("{output.plot}", "{input.raw}", "{input.ak8}", "{input.ak15}", "{params.cut_ak8}", "{params.cut_ak15}", {params.cut_level})'
        """

rule clustering_kinematics:     
    input:
        "plots/{dataset}/sanity_checks/SanityCheck.png",
        expand("plots/{{dataset}}/sanity_checks/SanityCheckKinematics{{suffix}}_dR_{jet_id}_nolim{type}.png", jet_id=["Jet", "fJ", "AK15"], type=["", "_All"])

rule run_clustering_dRplot:
    input:
        hadhad = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo_hadhad.root",
        nohadhad = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo.root"
    output:
        plot = "plots/{dataset}/sanity_checks/SanityCheck.png"
    shell:
        """
        root -l -b -q 'SanityCheck.C("{input.hadhad}", "{input.nohadhad}", "{output.plot}")'
        """

rule run_clustering_Scatters:
    input:
        raw = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo{w.suffix}.root"
    output:
        plots = expand("plots/{{dataset}}/sanity_checks/SanityCheckKinematics{{suffix}}_dR_{jet_id}_nolim{type}.png", jet_id=["Jet", "fJ", "AK15"], type=["", "_All"])
    params:
        prefix = "plots/{dataset}/sanity_checks/SanityCheckKinematics{suffix}"
    shell:
        """
        root -l -b -q 'SanityCheckOfSanityCheck.C("{input.raw}", "{params.prefix}")'
        """

rule run_eff_diffs:
    input:
        raw_had  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo_hadhad.root",
        raw_inc  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo.root",
        ak8_had  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet_hadhad.root",
        ak8_inc  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet.root",
        ak15_had = lambda w: f"{DATA_MAP[w.dataset]}/AK15_hadhad.root",
        ak15_inc = lambda w: f"{DATA_MAP[w.dataset]}/AK15.root"
    output:
        plot = "plots/{dataset}/efficiencies/MatchingEffDiff_inclusive_minus_hadhad_allJets.png"
    params:
        save_path = "plots/{dataset}/efficiencies",
        jet_path  = lambda w: DATA_MAP[w.dataset]
    shell:
        """
        root -l -b -q 'PlotEffDiffs.C("{params.save_path}", "{params.jet_path}")'
        """

rule run_decay_prod_fractions:
    input:
        raw = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo{w.suffix}.root"
    output:
        plot = "plots/{dataset}/efficiencies/EnergyFractionsOfDecayProds{suffix}.png"
    params:
        normalize = "true"
    shell:
        """
        root -l -b -q 'PlotDecayProdEnergyFractions.C("{input.raw}", "{output.plot}", {params.normalize})'
        """

rule run_channel_efficiencies:
    input:
        raw  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo.root",
        ak8  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet.root",
        ak15 = lambda w: f"{DATA_MAP[w.dataset]}/AK15.root"
    output:
        plot = "plots/{dataset}/efficiencies/effAndResponse_byChannel_grid.png"
    params:
        jet_path  = lambda w: DATA_MAP[w.dataset]
    shell:
        """
        root -l -b -q 'DecayChannelvEfficiency.C("{output.plot}", "{params.jet_path}")'
        """

rule run_jet_plot_sig:
    input:
        lambda w: [f"{DATA_MAP[w.dataset]}/{JET_NAMES[j]}{w.suffix}.root" for j in REQUESTED_JETS]
    output:
        f"plots/{{dataset}}/distributions/{_ak4_str}{_ak8_str}{_ak15_str}{_tau_str}{_clean_jet}{{suffix}}_plot.png"
    params:
        ak4 = "true" if "AK4" in REQUESTED_JETS else "false",
        ak8 = "true" if "AK8" in REQUESTED_JETS else "false",
        ak15 = "true" if "AK15" in REQUESTED_JETS else "false",
        tau = "true" if "Tau" in REQUESTED_JETS else "false",
        plot_params = JET_PARAMS,
        normalize = NORMALIZE,
        hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        jet_path = lambda w: DATA_MAP[w.dataset],
        bg_path = "",
        bg_chan = ""
    shell:
        """
        root -l -b -q 'Plots.C({params.ak4}, {params.ak8}, {params.ak15}, {params.tau}, "{params.bg_path}", "{params.bg_chan}", "{params.plot_params}", "{output}", {params.normalize}, {params.hadhad}, "{params.jet_path}")'
        """

rule run_jet_plot_bg:
    input:
        lambda w: [f"{DATA_MAP[w.dataset]}/{JET_NAMES[j]}{w.suffix}.root" for j in REQUESTED_JETS]
    output:
        "plots/{dataset}/distributions/{jet_prefix}" + _clean_jet + "{suffix}_{bg}_plot.png"
    params:
        # Dynamically set which single jet is passed to the macro based on the filename prefix
        ak4 = lambda w: "true" if w.jet_prefix == "Jet_" else "false",
        ak8 = lambda w: "true" if w.jet_prefix == "FatJet_" else "false",
        ak15 = lambda w: "true" if w.jet_prefix == "AK15_" else "false",
        tau = lambda w: "true" if w.jet_prefix == "Tau_" else "false",
        plot_params = JET_PARAMS,
        normalize = NORMALIZE,
        hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        jet_path = lambda w: DATA_MAP[w.dataset],
        bg_path = lambda w: BG_MAP[w.bg],
        bg_chan = lambda w: w.bg
    shell:
        """
        root -l -b -q 'Plots.C({params.ak4}, {params.ak8}, {params.ak15}, {params.tau}, "{params.bg_path}", "{params.bg_chan}", "{params.plot_params}", "{output}", {params.normalize}, {params.hadhad}, "{params.jet_path}")'
        """

rule run_subjet_plot_sig:
    input:
        lambda w: [f"{DATA_MAP[w.dataset]}/{JET_NAMES[j]}{w.suffix}.root" for j in REQUESTED_JETS]
    output:
        f"plots/{{dataset}}/distributions/{_ak8_str}{_ak15_str}{_clean_subjet}{{suffix}}_plot.png"
    params:
        ak8 = "true" if "AK8" in REQUESTED_JETS else "false",
        ak15 = "true" if "AK15" in REQUESTED_JETS else "false",
        plot_params = SUBJET_PARAMS,
        normalize = NORMALIZE,
        hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        jet_path = lambda w: DATA_MAP[w.dataset],
        bg_path = "",
        bg_chan = ""
    shell:
        """
        root -l -b -q 'Plots.C(false, {params.ak8}, {params.ak15}, false, "{params.bg_path}", "{params.bg_chan}", "{params.plot_params}", "{output}", {params.normalize}, {params.hadhad}, "{params.jet_path}")'
        """

rule run_subjet_plot_bg:
    input:
        lambda w: [f"{DATA_MAP[w.dataset]}/{JET_NAMES[j]}{w.suffix}.root" for j in REQUESTED_JETS]
    output:
        "plots/{dataset}/distributions/{jet_prefix}" + _clean_subjet + "{suffix}_{bg}_plot.png"
    params:
        ak8 = lambda w: "true" if w.jet_prefix == "FatJet_" else "false",
        ak15 = lambda w: "true" if w.jet_prefix == "AK15_" else "false",
        plot_params = SUBJET_PARAMS,
        normalize = NORMALIZE,
        hadhad = lambda w: "true" if w.suffix == "_hadhad" else "false",
        jet_path = lambda w: DATA_MAP[w.dataset],
        bg_path = lambda w: BG_MAP[w.bg],
        bg_chan = lambda w: w.bg
    shell:
        """
        root -l -b -q 'Plots.C(false, {params.ak8}, {params.ak15}, false, "{params.bg_path}", "{params.bg_chan}", "{params.plot_params}", "{output}", {params.normalize}, {params.hadhad}, "{params.jet_path}")'
        """

rule run_pt_effs:
    input:
        raw  = lambda w: f"{DATA_MAP[w.dataset]}/RawEventInfo{w.suffix}.root",
        tau  = lambda w: f"{DATA_MAP[w.dataset]}/Tau{w.suffix}.root",
        ak8  = lambda w: f"{DATA_MAP[w.dataset]}/fatJet{w.suffix}.root",
        ak15 = lambda w: f"{DATA_MAP[w.dataset]}/AK15{w.suffix}.root"
    params:
        output_dir = "plots/{dataset}/efficiencies/JetFatJetAK15_recoeff{suffix}"
    output:
        plot = "plots/{dataset}/efficiencies/JetFatJetAK15_recoeff{suffix}.png"
    shell:
        """
        root -l -b -q 'PlotEff_OnlyPT.C("{params.output_dir}", "{input.raw}", "{input.tau}", "{input.ak8}", "{input.ak15}")'
        """