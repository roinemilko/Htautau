import os
import glob
import subprocess

from snakemake.exceptions import WorkflowError

_CONFIG_DEFAULTS = {
    "signal_dirs": {},
    "signal_das": {},
    "bg_dirs": {},
    "bg_das": {},
    "max_files": 0,
    "data": "MADGRAPH, POWHEG",
    "channel": "both",
    "exclude": "",
    "bg-channels": "DYto2Tau, TTto2L2Nu, TTto4Q, TTtoLNu2Q",
}
for _key, _default in _CONFIG_DEFAULTS.items():
    if config.get(_key) is None:
        config[_key] = _default

DATA_DIRS = config["signal_dirs"]
DAS_DATASETS = config["signal_das"]
BG_DATA_DIRS = config["bg_dirs"]
DAS_BG_DATASETS = config["bg_das"]
MAX_FILES = config["max_files"]

_use_data_str = config["data"]
_channel_mode = config["channel"]
_excluded_str = config["exclude"]
_bg_channel_str = config["bg-channels"]

DATA = [x.strip() for x in _use_data_str.split(",")]
EXCLUDED_JETS = [x.strip() for x in _excluded_str.split(",")] if _excluded_str else []

SUFFIXES = []
if _channel_mode in ["both", "inclusive_only"]:
    SUFFIXES.append("") 
if _channel_mode in ["both", "hadhad_only"]:
    SUFFIXES.append("_hadhad") 

JET_NAMES = {
    "AK4": "Jet",
    "AK8": "fatJet",
    "AK15": "AK15",
    "Tau": "Tau"
}

BG_NAMES = {
    "AK8": "fatJetBG",
    "AK15": "AK15BG",
    "Tau": "TauBG"
}

REQUESTED_JETS = [j for j in JET_NAMES.keys() if j not in EXCLUDED_JETS]
REQUESTED_BGS = [x.strip() for x in _bg_channel_str.split(",")] if _bg_channel_str else [""]
VALID_BGS = [bg for bg in REQUESTED_BGS if bg]

EXPECTED_SKIMS = [
    f"jets/{dataset}/RawEventInfo{suffix}.root"
    for dataset in DATA
    for suffix in SUFFIXES
] + [
    f"jets/{dataset}/{JET_NAMES[j]}{suffix}.root"
    for dataset in DATA
    for suffix in SUFFIXES
    for j in REQUESTED_JETS
]

EXPECTED_BG_SKIMS = [
    f"background/{bg}/{BG_NAMES[j]}_{bg}.root"
    for bg in VALID_BGS
    for j in REQUESTED_JETS if j in BG_NAMES
]

valid_bg_suffixes = [f"_{bg}" for bg in VALID_BGS]
bgsuffix_constraint = "|".join(valid_bg_suffixes) + "|" if valid_bg_suffixes else ".*"

ALL_DATA_KEYS = list(DATA_DIRS.keys()) + list(DAS_DATASETS.keys())
ALL_BG_KEYS = list(BG_DATA_DIRS.keys()) + list(DAS_BG_DATASETS.keys())

def _validate_data_config():
    problems = []
    for d in DATA:
        if d not in ALL_DATA_KEYS:
            problems.append(
                f"dataset '{d}' (from config 'data') has no entry in signal_dirs or signal_das"
            )
    for bg in VALID_BGS:
        if bg not in ALL_BG_KEYS:
            problems.append(
                f"background '{bg}' (from config 'bg-channels') has no entry in bg_dirs or bg_das"
            )
    if problems:
        raise WorkflowError(
            "config.yaml is missing required entries for data_workflow:\n  - " + "\n  - ".join(problems)
        )

_validate_data_config()

wildcard_constraints:
    dataset  = "|".join(ALL_DATA_KEYS) if ALL_DATA_KEYS else ".*",
    bg       = "|".join(ALL_BG_KEYS) if ALL_BG_KEYS else ".*",
    suffix   = "_hadhad|",
    bgsuffix = bgsuffix_constraint

rule all:
    input:
        EXPECTED_SKIMS,
        EXPECTED_BG_SKIMS

rule skim:
    input:
        EXPECTED_SKIMS

rule skim_bg:
    input:
        EXPECTED_BG_SKIMS

rule create_file_lists:
    output:
        "file_lists/{dataset_or_bg}.txt"
    run:
        target = wildcards.dataset_or_bg
        is_bg = target in BG_DATA_DIRS or target in DAS_BG_DATASETS
        files = []
        
        if target in DAS_DATASETS or target in DAS_BG_DATASETS:
            das_path = DAS_DATASETS.get(target) or DAS_BG_DATASETS.get(target)

            query = f"file dataset={das_path}"
            if "USER" in das_path and "instance=" not in das_path:
                query += " instance=prod/phys03"

            limit_flag = f"-limit={MAX_FILES}" if MAX_FILES > 0 else ""
            cmd = f"dasgoclient -query=\"{query}\" {limit_flag}"

            print(f"Querying DAS: {cmd}")

            clean_env = os.environ.copy()
            clean_env.pop("PYTHONHOME", None)
            clean_env.pop("PYTHONPATH", None)

            proxy = clean_env.get("X509_USER_PROXY")
            if not proxy or not os.path.exists(proxy):
                raise WorkflowError(
                    f"No valid grid proxy found for the DAS query on '{target}' "
                    f"(X509_USER_PROXY={proxy!r}). Run 'voms-proxy-init --voms cms' and retry."
                )

            try:
                res = subprocess.run(
                    cmd, shell=True, text=True, env=clean_env,
                    capture_output=True, check=True,
                )
            except FileNotFoundError as e:
                raise WorkflowError(
                    "'dasgoclient' was not found. Make sure the CMS/LCG environment is "
                    "sourced (see run.sh) before running data_workflow."
                ) from e
            except subprocess.CalledProcessError as e:
                raise WorkflowError(
                    f"DAS query failed for '{target}' (dataset={das_path}):\n"
                    f"  command: {cmd}\n"
                    f"  stderr: {e.stderr.strip()}\n"
                    "Check that the dataset path in config.yaml is correct and that your grid "
                    "proxy is valid ('voms-proxy-info --exists')."
                ) from e

            files = [f"root://cms-xrd-global.cern.ch/{f}" for f in res.stdout.splitlines() if f.endswith('.root')]

            if not files:
                raise WorkflowError(
                    f"DAS query for '{target}' (dataset={das_path}) returned no ROOT files. "
                    "Double-check the dataset path in config.yaml, e.g. with "
                    f"'dasgoclient -query=\"{query}\"'."
                )

        else:
            local_path = BG_DATA_DIRS.get(target) if is_bg else DATA_DIRS.get(target)

            if not local_path:
                raise WorkflowError(
                    f"'{target}' is not configured: add it to signal_dirs/signal_das "
                    "(or bg_dirs/bg_das for backgrounds) in config.yaml."
                )

            if not os.path.isdir(local_path):
                raise WorkflowError(
                    f"Configured path for '{target}' does not exist or is not a directory: {local_path}"
                )

            files = glob.glob(f"{local_path}/*.root")
            if MAX_FILES > 0:
                files = files[:MAX_FILES]

            if not files:
                raise WorkflowError(
                    f"No .root files found for '{target}' under {local_path}."
                )

        os.makedirs("file_lists", exist_ok=True)
        with open(output[0], "w") as f:
            f.write("\n".join(files))

rule skim_run:
    input:
        file_list = "file_lists/{dataset}.txt",
        so = "skimmer/BuildData_C.so"
    output:
        raw = "jets/{dataset}/RawEventInfo{suffix}.root",
        jets = [f"jets/{{dataset}}/{JET_NAMES[j]}{{suffix}}.root" for j in REQUESTED_JETS]
    threads: 6
    params:
        hadhad  = lambda w: "true" if w.suffix == "_hadhad" else "false",
        out_path= "jets/{dataset}",
        inc_ak4  = "true" if "AK4" in REQUESTED_JETS else "false",
        inc_ak8  = "true" if "AK8" in REQUESTED_JETS else "false",
        inc_ak15 = "true" if "AK15" in REQUESTED_JETS else "false",
        inc_tau  = "true" if "Tau" in REQUESTED_JETS else "false"
    shell:
        """
        root -l -b -q -e 'gSystem->Load("{input.so}"); BuildData("{input.file_list}", {params.inc_ak4}, {params.inc_ak8}, {params.inc_ak15}, true, {params.inc_tau}, {params.hadhad}, "{params.out_path}", {threads});'
        """

rule skim_bg_run:
    input:
        file_list = "file_lists/{bg}.txt",
        so = "skimmer/BuildBg_C.so"
    output:
        jets = [f"background/{{bg}}/{BG_NAMES[j]}_{{bg}}.root" for j in REQUESTED_JETS if j in BG_NAMES]
    threads: 6
    params:
        out_path= "background/{bg}",
        identifyer = lambda w: f"_{w.bg}",
        inc_ak8  = "true" if "AK8" in REQUESTED_JETS else "false",
        inc_ak15 = "true" if "AK15" in REQUESTED_JETS else "false",
        inc_tau  = "true" if "Tau" in REQUESTED_JETS else "false"
    shell:
        """
        root -l -b -q -e 'gSystem->Load("{input.so}"); BuildBg("{input.file_list}", "{params.out_path}", "{params.identifyer}", {params.inc_tau}, {params.inc_ak8}, {params.inc_ak15}, {threads});'
        """

rule compile:
    input:
        "skimmer/BuildData.C"
    output:
        "skimmer/BuildData_C.so"
    shell:
        """
        root -l -b -q -e 'int status = gSystem->CompileMacro(\"skimmer/BuildData.C\", \"kf\"); gSystem->Exit(status == 1 ? 0 : 1);'
        """

rule compile_bg:
    input:
        "skimmer/BuildBg.C"
    output:
        "skimmer/BuildBg_C.so"
    shell:
        """
        root -l -b -q -e 'int status = gSystem->CompileMacro(\"skimmer/BuildBg.C\", \"kf\"); gSystem->Exit(status == 1 ? 0 : 1);'
        """